#!icon = https://i.xiaotucc.com/account_logo

[Script]
http-response ^https://mapi\.xiaotucc\.com/we/user/base/login script-path=https://raw.githubusercontent.com/KingLingo/Loon-Scripts/main/scripts/tools/xtcc-hijack.js, requires-body=true, timeout=10, tag=登录劫持
